{
  "schema": 1,
  "title": "The change since the last reading: the same cases the Sugar Sense apps run.",
  "constants": {
    "windowSeconds": 270,
    "maxGapSeconds": 1200,
    "mgdlToMmol": 0.0555,
    "minusGlyph": "−",
    "flatMgdl": "0",
    "flatMmol": "0.0"
  },
  "notes": [
    "points are oldest first; ageSec is seconds before the newest point; mgdl is the raw reading.",
    "partner: the newest point at least windowSeconds older than the newest reading, else the oldest one within maxGapSeconds; none across a wider gap or without an older reading.",
    "text: the mg/dL difference converted to the display unit, rounded half away from zero, a real minus sign, a flat pair reads 0."
  ],
